function gv(r,k){return r[k];}
function gn(r,k){var v=parseFloat(r[k]);return isNaN(v)?0:v;}
function sum(arr){return arr.reduce(function(a,b){return a+b;},0);}
function avg(arr){return arr.length?sum(arr)/arr.length:0;}
function fmt(n){return n==null?'—':n.toLocaleString('ar-SA',{minimumFractionDigits:2,maximumFractionDigits:2})+' ر.س';}
function fmtI(n){return n==null?'—':n.toLocaleString();}
function fmtPct(n){return n==null?'—':(n*100).toFixed(1)+'%';}
function invSet(d){var s=new Set();d.forEach(function(r){if(gv(r,'InvoiceNumber'))s.add(String(gv(r,'InvoiceNumber')));});return s.size;}
function branches(d){var s=new Set();d.forEach(function(r){var b=String(gv(r,'BranchCode')||'').trim();if(b)s.add(b);});return Array.from(s).sort();}
function pharmacists(d){var s=new Set();d.forEach(function(r){var p=String(gv(r,'SalesName')||'').trim();if(p)s.add(p);});return Array.from(s);}
function months(d){var s=new Set();d.forEach(function(r){var m=String(gv(r,'MONTHS')||'').trim();if(m)s.add(m);});return Array.from(s);}
function grClass(sc){return sc>=90?'gr-a':sc>=75?'gr-b':sc>=60?'gr-c':'gr-d';}
function grLetter(sc){return sc>=90?'A':sc>=75?'B':sc>=60?'C':'D';}
function grColor(sc){return sc>=90?'#10b981':sc>=75?'#3b82f6':sc>=60?'#f59e0b':'#ef4444';}

function catSplit(d){
  return {
    cash:d.filter(function(r){var t=String(gv(r,'InvoiceType')||'').toLowerCase();return t==='normal'||t==='cashcustomer';}),
    was:d.filter(function(r){return String(gv(r,'InvoiceType')||'').toLowerCase()==='wasfaty';}),
    ins:d.filter(function(r){return String(gv(r,'InvoiceType')||'').toLowerCase()==='insurance';}),
    online:d.filter(function(r){return String(gv(r,'InvoiceType')||'').toLowerCase()==='online';})
  };
}

