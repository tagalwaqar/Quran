        {label:t('predicted'),data:predData,borderColor:'#f59e0b',borderDash:[6,3],backgroundColor:'rgba(245,158,11,.08)',fill:true,tension:.4,pointRadius:5,pointStyle:'triangle',pointBackgroundColor:'#f59e0b'}
      ]},
      options:{responsive:true,maintainAspectRatio:false,
        plugins:{legend:{labels:{color:'#94a3b8',font:{family:'Cairo'}}}},
        scales:{x:{ticks:{color:'#94a3b8'}},y:{ticks:{color:'#94a3b8'}}}}});
  },50);
}

// ═══════════════════════════════════════════════════════
//  ABC-XYZ
// ═══════════════════════════════════════════════════════
function renderABCXYZ(){
  var p=document.getElementById('p-abcxyz');
  if(!sales.length){p.innerHTML=noDataHtml();return;}
  var allM=months(raw);var imap={};
  sales.forEach(function(r){
    var k=(gv(r,'Name')||gv(r,'ItemBarCode')||'?').toString().trim().substring(0,40);
    var m=String(gv(r,'MONTHS')||'').trim();
    if(!imap[k])imap[k]={total:0,months:{}};
    imap[k].total+=gn(r,'ItemsNetPrice');
    imap[k].months[m]=(imap[k].months[m]||0)+gn(r,'ItemsNetPrice');
  });
  var items=Object.entries(imap).map(function(e){
    var vals=allM.map(function(m){return e[1].months[m]||0;});
    var mn=avg(vals);var std=Math.sqrt(avg(vals.map(function(v){return Math.pow(v-mn,2);})));
    var cv=mn>0?std/mn:0;
    return {name:e[0],total:e[1].total,cv:cv};
  }).sort(function(a,b){return b.total-a.total;});
  var tot=sum(items.map(function(x){return x.total;}));
  var cum=0,aEnd=0,bEnd=0;
  items.forEach(function(x,i){cum+=x.total;if(cum/tot<=0.8&&!aEnd)aEnd=i;if(cum/tot<=0.95&&!bEnd)bEnd=i;});
  items.forEach(function(x,i){x.abc=i<=aEnd?'A':i<=bEnd?'B':'C';x.xyz=x.cv<0.5?'X':x.cv<1?'Y':'Z';x.cell=x.abc+x.xyz;});
  var cColor={AX:'#10b981',AY:'#10b981',AZ:'#f59e0b',BX:'#3b82f6',BY:'#3b82f6',BZ:'#f59e0b',CX:'#94a3b8',CY:'#94a3b8',CZ:'#ef4444'};
  var cDesc={AX:'High Value, Stable',AY:'High Value, Variable',AZ:'High Value, Unpredictable',BX:'Medium, Stable',BY:'Medium, Variable',BZ:'Medium, Unpredictable',CX:'Low, Stable',CY:'Low, Variable',CZ:'Low, Unpredictable'};
  var cells=['AX','AY','AZ','BX','BY','BZ','CX','CY','CZ'];
  var counts={};cells.forEach(function(c){counts[c]=items.filter(function(x){return x.cell===c;}).length;});

  p.innerHTML=expBar('p-abcxyz','ABC-XYZ')
  +'<div class="card"><div class="card-title">🔬 مصفوفة ABC-XYZ</div>'
  +'<div style="display:grid;grid-template-columns:auto 1fr 1fr 1fr;gap:4px;max-width:480px;margin-bottom:20px">'
    +'<div></div>'
    +['X (مستقر)','Y (متغير)','Z (غير منتظم)'].map(function(h){return '<div style="text-align:center;font-size:10.5px;font-weight:700;color:var(--tl);padding:6px">'+h+'</div>';}).join('')
    +['A (80%)','B (95%)','C (باقي)'].map(function(r,ri){
      return '<div style="font-size:10.5px;font-weight:700;color:var(--tl);display:flex;align-items:center;padding:6px">'+r+'</div>'
        +['X','Y','Z'].map(function(c){var cell=String.fromCharCode(65+ri)+c;var col=cColor[cell];
          return '<div class="abc-cell" style="background:'+col+'22;border:1px solid '+col+'44" onclick="showABCDet(\''+cell+'\')" title="'+cDesc[cell]+'">'
            +'<div class="abc-lbl" style="color:'+col+'">'+cell+'</div><div class="abc-cnt" style="color:'+col+'">'+counts[cell]+'</div></div>';}).join('');
    }).join('')
  +'</div>'
  +'<div id="abcDetail"></div></div>'
  +'<div class="card"><div class="card-title">📋 تفاصيل أعلى 30 صنف</div>'
  +'<div class="tbl-wrap"><table class="dtbl" id="abcTbl"><thead><tr>'
  +'<th>#</th><th>'+t('item')+'</th><th>'+t('revenue')+'</th><th>% تراكمي</th><th>ABC</th><th>XYZ</th><th>الخلية</th><th>التوصية</th>'
  +'</tr></thead><tbody>'
  +(function(){var c2=0;return items.slice(0,30).map(function(x,i){c2+=x.total;var col=cColor[x.cell];var cp=(c2/tot*100).toFixed(1);
    return '<tr><td>'+(i+1)+'</td><td style="font-size:11px;max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="'+x.name+'">'+x.name+'</td>'
      +'<td>'+fmt(x.total)+'</td><td>'+cp+'%</td>'
      +'<td style="font-weight:800;color:#10b981">'+x.abc+'</td><td style="font-weight:800;color:#3b82f6">'+x.xyz+'</td>'
      +'<td><span style="background:'+col+'22;color:'+col+';padding:2px 8px;border-radius:12px;font-weight:800;font-size:10px">'+x.cell+'</span></td>'
      +'<td style="font-size:10.5px;color:var(--tl)">'+cDesc[x.cell]+'</td></tr>';}).join('');})()
  +'</tbody></table></div></div>';
  window._abcItems=items;window._abcCC=cColor;window._abcCD=cDesc;
}
function showABCDet(cell){
  var items=window._abcItems||[];var col=(window._abcCC||{})[cell];var desc=(window._abcCD||{})[cell]||'';
  var filtered=items.filter(function(x){return x.cell===cell;});
  var el=document.getElementById('abcDetail');if(!el)return;
  el.innerHTML='<div style="background:'+col+'11;border:1px solid '+col+'33;border-radius:10px;padding:14px;margin-top:12px">'
    +'<div style="font-size:13px;font-weight:800;color:'+col+';margin-bottom:8px">'+cell+' — '+desc+'</div>'
    +'<div style="display:flex;flex-wrap:wrap;gap:5px">'
    +filtered.slice(0,20).map(function(x){return '<span style="background:var(--bg);padding:3px 9px;border-radius:16px;font-size:10.5px;border:1px solid var(--b)">'+x.name+'</span>';}).join('')
    +(filtered.length>20?'<span style="color:var(--tl);font-size:10px">و '+(filtered.length-20)+' آخرين...</span>':'')
    +'</div></div>';
}


