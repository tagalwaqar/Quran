<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>OPEX Dashboard — United Pharmacy لوحة التميز التشغيلي</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.28/jspdf.plugin.autotable.min.js"></script>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{
  --p:#0d9488;--pl:#2dd4bf;--pd:#5eead4;--s:#f59e0b;
  --bg:#0f172a;--cb:#1e293b;--cb2:#162032;
  --t:#f1f5f9;--tl:#94a3b8;--b:#334155;
  --sh:0 10px 30px rgba(0,0,0,.4);
  --g:linear-gradient(135deg,#0d9488,#065f46);
  --gr:linear-gradient(135deg,#ef4444,#b91c1c);
  --ga:linear-gradient(135deg,#f59e0b,#d97706);
  --gb:linear-gradient(135deg,#3b82f6,#1d4ed8);
  --sidebar-w:260px;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:'Cairo',sans-serif;background:var(--bg);color:var(--t);min-height:100vh;overflow-x:hidden}
body::before{content:'';position:fixed;inset:0;background:radial-gradient(ellipse at 10% 20%,rgba(13,148,136,.06) 0,transparent 50%),radial-gradient(ellipse at 90% 80%,rgba(245,158,11,.05) 0,transparent 50%);z-index:-1;pointer-events:none}

/* ───── SIDEBAR ───── */
.sidebar{position:fixed;top:0;right:0;width:var(--sidebar-w);height:100vh;background:var(--cb);border-left:1px solid var(--b);z-index:1000;display:flex;flex-direction:column;box-shadow:var(--sh);transition:transform .3s}
body[dir=ltr] .sidebar{right:auto;left:0;border-left:none;border-right:1px solid var(--b)}
.sb-head{padding:20px 16px;background:var(--g);position:relative;overflow:hidden;flex-shrink:0}
.sb-head::after{content:'';position:absolute;inset:-50%;background:radial-gradient(circle,rgba(255,255,255,.08) 0,transparent 60%);pointer-events:none}
.sb-logo-wrap{display:flex;align-items:center;gap:10px;position:relative;z-index:1}
.sb-logo-icon{width:40px;height:40px;background:rgba(255,255,255,.15);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
.sb-title{font-size:13px;font-weight:900;color:#fff;line-height:1.3}
.sb-sub{font-size:10px;opacity:.75;color:#fff}
.sb-nav{flex:1;overflow-y:auto;padding:8px 0}
.sb-nav::-webkit-scrollbar{width:3px}
.sb-nav::-webkit-scrollbar-thumb{background:var(--b);border-radius:2px}
.nav-group{padding:10px 16px 4px;font-size:9px;font-weight:900;color:var(--tl);text-transform:uppercase;letter-spacing:1px}
.nav-item{display:flex;align-items:center;gap:10px;padding:10px 16px;cursor:pointer;color:var(--tl);font-weight:700;font-size:12.5px;transition:.2s;border-right:3px solid transparent;white-space:nowrap}
body[dir=ltr] .nav-item{border-right:none;border-left:3px solid transparent}
.nav-item:hover{background:rgba(13,148,136,.07);color:var(--pl)}
.nav-item.active{background:rgba(13,148,136,.12);color:var(--pl);border-right-color:var(--p)}
body[dir=ltr] .nav-item.active{border-left-color:var(--p)}
.nav-icon{font-size:15px;width:20px;text-align:center;flex-shrink:0}
.nav-div{height:1px;background:var(--b);margin:4px 16px}
.sb-foot{padding:12px 16px;border-top:1px solid var(--b);flex-shrink:0}

/* ───── MAIN ───── */
.main{min-height:100vh;padding-bottom:60px;transition:margin .3s}
.topbar{background:rgba(15,23,42,.9);backdrop-filter:blur(12px);padding:10px 20px;display:flex;justify-content:space-between;align-items:center;position:sticky;top:0;z-index:900;border-bottom:1px solid var(--b);gap:10px;flex-wrap:wrap}
.topbar-l{display:flex;align-items:center;gap:10px}
.topbar-r{display:flex;align-items:center;gap:6px;flex-wrap:wrap}
#pageTitle{font-size:17px;font-weight:900;color:var(--pd)}
.mob-toggle{display:none;background:none;border:none;font-size:22px;color:var(--pd);cursor:pointer;padding:4px}

/* ───── FILTERS ───── */
.filter-row{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.fsel{background:var(--bg);border:1px solid var(--b);color:var(--t);border-radius:8px;padding:6px 10px;font-family:'Cairo';font-size:11.5px;cursor:pointer;transition:.2s}
.fsel:focus{border-color:var(--pl);outline:none}
select.fsel option{background:var(--cb)}
.lang-btn{background:rgba(13,148,136,.12);color:var(--pd);border:1px solid rgba(13,148,136,.3);padding:6px 12px;border-radius:7px;font-weight:900;cursor:pointer;font-size:11px;transition:.2s}
.lang-btn:hover{background:var(--p);color:#fff}

/* ───── BUTTONS ───── */
.btn{padding:8px 16px;border-radius:8px;font-weight:800;cursor:pointer;border:none;transition:.2s;display:inline-flex;align-items:center;gap:6px;font-family:'Cairo';font-size:12px;white-space:nowrap}
.btn-p{background:var(--g);color:#fff;box-shadow:0 4px 12px rgba(13,148,136,.25)}
.btn-p:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(13,148,136,.35)}
.btn-s{background:var(--cb);color:var(--pl);border:1.5px solid var(--pl)}
.btn-s:hover{background:var(--p);color:#fff}
.btn-r{background:rgba(239,68,68,.1);color:#ef4444;border:1.5px solid rgba(239,68,68,.3)}
.btn-r:hover{background:#ef4444;color:#fff}
.btn-sm{padding:5px 10px;font-size:11px}
.btn-full{width:100%;justify-content:center}
.q-btns{display:flex;gap:3px;background:rgba(13,148,136,.08);padding:3px;border-radius:8px;border:1px solid rgba(13,148,136,.15)}
.q-btn{padding:4px 9px;border-radius:5px;border:none;background:transparent;color:var(--tl);font-family:'Cairo';font-size:10.5px;font-weight:700;cursor:pointer;transition:.2s}
.q-btn.active{background:var(--p);color:#fff}
.q-btn:hover:not(.active){background:rgba(13,148,136,.15);color:var(--pl)}

/* ───── KPI ───── */
.kpi-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-bottom:22px}
.kpi{background:var(--cb);padding:18px 20px;border-radius:16px;box-shadow:var(--sh);border:1px solid var(--b);position:relative;overflow:hidden;transition:.25s}
.kpi:hover{transform:translateY(-2px);border-color:rgba(13,148,136,.3)}
.kpi::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
.kpi-icon{position:absolute;top:14px;left:16px;font-size:28px;opacity:.18}
body[dir=ltr] .kpi-icon{left:auto;right:16px}
.kpi-lb{font-size:10.5px;color:var(--tl);font-weight:700;text-transform:uppercase;letter-spacing:.5px;margin-bottom:7px}
.kpi-val{font-size:22px;font-weight:900;color:var(--pd);line-height:1}
.kpi-sub{font-size:10px;margin-top:5px;color:var(--tl);font-weight:600}
.kpi-delta{display:inline-flex;align-items:center;gap:3px;font-size:10px;font-weight:800;padding:2px 7px;border-radius:12px;margin-top:5px}
.kpi-up{background:rgba(16,185,129,.12);color:#10b981}
.kpi-dn{background:rgba(239,68,68,.12);color:#ef4444}

/* ───── CARD ───── */
.card{background:var(--cb);border-radius:18px;padding:20px 22px;margin-bottom:20px;box-shadow:var(--sh);border:1px solid var(--b)}
.card-title{font-size:14px;font-weight:900;color:var(--pd);margin-bottom:16px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.card-title .badge{font-size:9.5px;font-weight:700;padding:2px 8px;border-radius:16px;background:rgba(13,148,136,.15);color:var(--pl)}

/* ───── EXPORT BAR ───── */
.export-bar{display:flex;gap:5px;flex-wrap:wrap;margin-bottom:14px;padding:8px 10px;background:rgba(13,148,136,.05);border-radius:10px;border:1px solid rgba(13,148,136,.1)}

/* ───── TABLE ───── */
.tbl-wrap{overflow-x:auto;border-radius:10px;border:1px solid var(--b)}
.dtbl{width:100%;border-collapse:separate;border-spacing:0;font-size:12.5px}
.dtbl th{background:#1b2d40;padding:12px 14px;font-weight:800;color:var(--pl);border-bottom:2px solid var(--b);white-space:nowrap;position:sticky;top:0;z-index:1}
body[dir=rtl] .dtbl th{text-align:right}
body[dir=ltr] .dtbl th{text-align:left}
.dtbl td{padding:11px 14px;border-bottom:1px solid rgba(51,65,85,.5);color:var(--t);transition:.15s}
.dtbl tr:last-child td{border-bottom:none}
.dtbl tr:hover td{background:rgba(13,148,136,.04)}
.dtbl th[onclick]{cursor:pointer}
.dtbl th[onclick]:hover{color:#fff}

/* ───── BADGES ───── */
.gr-a{background:rgba(16,185,129,.15);color:#10b981;padding:3px 9px;border-radius:16px;font-weight:800;font-size:11px}
.gr-b{background:rgba(59,130,246,.15);color:#3b82f6;padding:3px 9px;border-radius:16px;font-weight:800;font-size:11px}
.gr-c{background:rgba(245,158,11,.15);color:#f59e0b;padding:3px 9px;border-radius:16px;font-weight:800;font-size:11px}
.gr-d{background:rgba(239,68,68,.15);color:#ef4444;padding:3px 9px;border-radius:16px;font-weight:800;font-size:11px}
.chk-ok{color:#10b981;font-weight:900;text-align:center}
.chk-no{color:#ef4444;font-weight:900;text-align:center}

/* ───── MODALS ───── */
.overlay{position:fixed;inset:0;background:rgba(15,23,42,.85);backdrop-filter:blur(12px);display:none;align-items:center;justify-content:center;z-index:9000;padding:16px}
.overlay.show{display:flex}
.modal{background:var(--cb);padding:26px;border-radius:18px;box-shadow:0 20px 60px rgba(0,0,0,.6);border:1px solid var(--b);width:100%;max-width:460px;max-height:90vh;overflow-y:auto}
.modal-title{font-size:16px;font-weight:900;color:var(--pd);margin-bottom:16px;display:flex;justify-content:space-between;align-items:center}
.finput{background:var(--bg);border:1px solid var(--b);color:var(--t);border-radius:8px;padding:9px 12px;font-family:'Cairo';font-size:12.5px;width:100%;transition:.2s}
.finput:focus{border-color:var(--pl);outline:none;box-shadow:0 0 0 3px rgba(13,148,136,.12)}
.flabel{font-size:10.5px;color:var(--tl);display:block;margin-bottom:3px;font-weight:700}

/* ───── LOADER & TOAST ───── */
.loader{position:fixed;inset:0;background:var(--bg);display:none;flex-direction:column;align-items:center;justify-content:center;z-index:10000}
.loader.on{display:flex}
.spin{width:42px;height:42px;border:4px solid var(--b);border-top-color:var(--p);border-radius:50%;animation:spin .9s linear infinite;margin-bottom:12px}
@keyframes spin{to{transform:rotate(360deg)}}
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(16px);background:linear-gradient(135deg,#1e293b,#0f172a);color:var(--t);padding:11px 22px;border-radius:10px;font-size:12.5px;font-weight:700;z-index:11000;opacity:0;transition:.3s;border:1px solid var(--b);box-shadow:var(--sh);pointer-events:none}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ───── PANELS ───── */
.panel{display:none}.panel.on{display:block;animation:fi .35s ease}
@keyframes fi{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.content{padding:18px 20px}
.dstatus{display:none;align-items:center;gap:8px;background:var(--cb);padding:7px 16px;border-radius:40px;border:1px solid var(--b);font-size:11.5px;font-weight:700;margin-bottom:14px;width:fit-content}
.dot{width:7px;height:7px;border-radius:50%;background:#34d399;animation:pulse 2s infinite;flex-shrink:0}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

/* ───── HOME GRID ───── */
.home-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;padding:4px}
.tool-card{background:var(--cb);padding:24px 18px;border-radius:18px;box-shadow:var(--sh);text-align:center;cursor:pointer;transition:.35s cubic-bezier(.175,.885,.32,1.275);border:1px solid var(--b);position:relative;overflow:hidden}
.tool-card::before{content:'';position:absolute;inset:0;background:var(--g);opacity:0;transition:.3s}
.tool-card:hover{transform:translateY(-6px);border-color:var(--pl)}
.tool-card:hover::before{opacity:.04}
.tool-card .tc-icon{font-size:38px;margin-bottom:12px;display:block;position:relative;z-index:1}
.tool-card .tc-name{font-size:14px;font-weight:800;margin-bottom:6px;color:var(--t);position:relative;z-index:1}
.tool-card .tc-desc{font-size:10.5px;color:var(--tl);line-height:1.6;position:relative;z-index:1}
.tool-card .tc-badge{position:absolute;top:12px;left:12px;background:var(--p);color:#fff;font-size:9px;font-weight:900;padding:2px 7px;border-radius:10px}
body[dir=ltr] .tool-card .tc-badge{left:auto;right:12px}

/* ───── CHART ───── */
.ch-wrap{position:relative;height:280px}

/* ───── PHARMACIST CARD ───── */
.ph-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:14px}
.ph-card{background:linear-gradient(135deg,rgba(13,148,136,.05),var(--cb));border:1px solid var(--b);border-radius:14px;padding:18px;transition:.25s}
.ph-card:hover{border-color:rgba(13,148,136,.3);transform:translateY(-2px)}
.ph-head{display:flex;align-items:center;gap:10px;margin-bottom:14px}
.ph-avatar{width:46px;height:46px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:900;background:var(--g);color:#fff;flex-shrink:0}
.ph-name{font-weight:800;font-size:13px}
.ph-grade{font-size:10px;margin-top:3px}

/* ───── ABC-XYZ ───── */
.abc-cell{padding:12px 8px;border-radius:8px;text-align:center;cursor:pointer;transition:.2s}
.abc-cell:hover{transform:scale(1.04)}
.abc-cell .abc-lbl{font-size:10px;font-weight:800;margin-bottom:3px}
.abc-cell .abc-cnt{font-size:20px;font-weight:900}

/* ───── ALERT CARDS ───── */
.alert-card{padding:16px;border-radius:12px;border-right:4px solid}
body[dir=ltr] .alert-card{border-right:none;border-left:4px solid}

/* ───── SEASON ───── */
.season-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:16px;font-size:10px;font-weight:700}
.s-high{background:rgba(239,68,68,.1);color:#ef4444}
.s-low{background:rgba(59,130,246,.1);color:#3b82f6}
.s-norm{background:rgba(107,114,128,.1);color:#6b7280}

/* ───── UPLOAD ZONE ───── */
.up-zone{border:2px dashed var(--b);border-radius:12px;padding:28px;text-align:center;cursor:pointer;transition:.2s}
.up-zone:hover,.up-zone.drag{border-color:var(--p);background:rgba(13,148,136,.03)}

/* ───── PROGRESS BAR ───── */
.prog-bar{background:var(--b);border-radius:4px;height:6px;overflow:hidden}
.prog-fill{height:100%;border-radius:4px;transition:width .6s}

/* ───── CAT TABS ───── */
.cat-tabs{display:flex;gap:5px;margin-bottom:16px;flex-wrap:wrap}
.cat-tab{padding:7px 14px;border-radius:16px;border:1.5px solid var(--b);font-size:11.5px;font-weight:700;cursor:pointer;transition:.2s;background:transparent;color:var(--tl);font-family:'Cairo'}
.cat-tab.active{background:var(--g);color:#fff;border-color:transparent}

/* ───── INSIGHTS BOX ───── */
.insights-box{background:rgba(13,148,136,.05);border-left:4px solid var(--p);padding:14px 16px;border-radius:8px;margin-bottom:20px}
body[dir=rtl] .insights-box{border-left:none;border-right:4px solid var(--p)}
.insights-box h4{margin-bottom:8px;color:var(--pd);display:flex;align-items:center;gap:7px;font-size:13px}
.insights-box p{font-size:12px;color:var(--tl);margin-bottom:4px;display:flex;align-items:flex-start;gap:6px}

/* ───── ALERT BADGE ───── */
.bell-wrap{position:relative;cursor:pointer;display:flex;align-items:center;justify-content:center;width:34px;height:34px;background:rgba(245,158,11,.1);border-radius:50%;color:#f59e0b}
.bell-badge{position:absolute;top:-3px;right:-3px;background:#ef4444;color:#fff;font-size:9px;font-weight:800;padding:2px 5px;border-radius:9px;border:2px solid var(--bg)}

/* ───── TIMELINE CHART ───── */
.hourly-bar-wrap{display:grid;grid-template-columns:repeat(24,1fr);gap:2px;height:80px;align-items:flex-end;margin-bottom:4px}
.h-bar{border-radius:3px 3px 0 0;min-height:4px;transition:opacity .2s;cursor:pointer}
.h-bar:hover{opacity:.7}
.hourly-labels{display:grid;grid-template-columns:repeat(24,1fr);gap:2px;font-size:8px;color:var(--tl);text-align:center}

/* ───── RESPONSIVE ───── */
@media(max-width:900px){
  .sidebar{transform:translateX(110%)}
  body[dir=ltr] .sidebar{transform:translateX(-110%)}
  .sidebar.open{transform:none}
  .main{margin:0!important}
  .mob-toggle{display:block}
  .ph-grid{grid-template-columns:1fr}
  .kpi-grid{grid-template-columns:1fr 1fr}
}
@media(max-width:480px){.kpi-grid{grid-template-columns:1fr}}
</style>
</head>
<body>

<div class="loader" id="loader"><div class="spin"></div><span id="loaderTxt">جاري المعالجة...</span></div>
<div class="toast" id="toast"></div>

<!-- ══ LOGIN ══ -->
<div class="overlay show" id="loginModal">
  <div class="modal" style="max-width:360px;text-align:center">
    <div style="margin-bottom:18px">
      <div style="background:#ffffff;border-radius:12px;padding:10px 14px;display:inline-block;box-shadow:0 6px 20px rgba(0,0,0,0.35);margin-bottom:12px">
        <img src="data:image/png;base64," alt="United Pharmacy" style="height:65px;display:block;margin:0 auto;object-fit:contain">
      </div>
      <h2 style="color:var(--pl);font-size:18px;font-weight:900;margin-bottom:3px">لوحة التميز التشغيلي</h2>
      <div style="color:var(--pd);font-size:11.5px;font-weight:700">United Pharmacy — Operational Excellence Dashboard</div>
    </div>
    <div style="margin-bottom:10px">
      <label class="flabel" style="text-align:right">اسم المستخدم | Username</label>
      <input class="finput" id="loginUser" placeholder="admin" autocomplete="username">
    </div>
    <div style="margin-bottom:16px">
      <label class="flabel" style="text-align:right">كلمة المرور | Password</label>
      <input class="finput" id="loginPass" type="password" placeholder="••••••" autocomplete="current-password" onkeydown="if(event.key==='Enter')checkLogin()">
    </div>
    <button class="btn btn-p btn-full" onclick="checkLogin()">🔐 دخول &nbsp;|&nbsp; Login</button>
    <div id="loginErr" style="color:#ef4444;font-size:11.5px;margin-top:10px;display:none">❌ بيانات الدخول غير صحيحة | Invalid credentials</div>
    <div style="display:flex;flex-direction:column;gap:8px;margin-top:14px">
      <button class="btn btn-p btn-full" onclick="quickLogin('ibrahim')" style="background:linear-gradient(135deg,#0d9488,#10b981);font-weight:900;padding:11px">⚡ دخول فوري كـ إبراهيم حتات (مشرف عام العمليات)</button>
      <button class="btn btn-s btn-full" onclick="quickLogin('admin')" style="font-size:11px;padding:8px">🔑 دخول سريع كـ المدير العام (Admin)</button>
    </div>
    <div style="margin-top:12px;padding-top:10px;border-top:1px solid var(--b);font-size:10.5px;color:var(--tl)">
      بيانات الدخول: <b>ibrahim</b> / <b>ibr2025</b> أو <b>admin</b> / <b>united2025</b>
    </div>
  </div>
</div>

<!-- ══ UPLOAD MODAL ══ -->
<div class="overlay" id="uploadModal">
  <div class="modal">
    <div class="modal-title"><span>📁 رفع ملفات Excel | Upload Files</span><button class="btn btn-s btn-sm" onclick="closeOverlay('uploadModal')">✕</button></div>
    <div class="up-zone" id="upZone" onclick="document.getElementById('fi').click()" ondragover="event.preventDefault();this.classList.add('drag')" ondragleave="this.classList.remove('drag')" ondrop="handleDrop(event)">
      <div style="font-size:36px;margin-bottom:8px">📊</div>
      <div style="font-weight:700;margin-bottom:4px">اسحب ملفات Excel هنا أو اضغط للاختيار</div>
      <div style="font-size:10.5px;color:var(--tl)">يدعم .xlsx و .xls — SalesDetailsReport</div>
    </div>
    <input type="file" id="fi" accept=".xlsx,.xls" multiple style="display:none" onchange="handleFiles(this.files)">
    <div id="upStatus" style="margin-top:10px;font-size:11.5px;color:var(--tl);text-align:center"></div>
  </div>
</div>

<!-- ══ SIDEBAR ══ -->
<aside class="sidebar" id="sidebar">
  <div class="sb-head">
