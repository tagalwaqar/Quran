// ═══════════════════════════════════════════════════════
//  KPI
// ═══════════════════════════════════════════════════════
function renderKPI(){
  var p=document.getElementById('p-kpi');
  if(!sales.length){p.innerHTML=noDataHtml();return;}
  var brs=branches(sales);
  var totS=sum(sales.map(function(r){return gn(r,'ItemsNetPrice');}));
  var totIC=invSet(sales);var totAI=totIC?totS/totIC:0;
  var rows=brs.map(function(b){
    var bd=sales.filter(function(r){return String(gv(r,'BranchCode')||'').trim()===b;});
    var br=rets.filter(function(r){return String(gv(r,'BranchCode')||'').trim()===b;});
    var sp=catSplit(bd);
    var s=sum(bd.map(function(r){return gn(r,'ItemsNetPrice');}));
    var ret=sum(br.map(function(r){return Math.abs(gn(r,'ItemsNetPrice'));}));
    var ic=invSet(bd);var ai=ic?s/ic:0;var rr=s>0?ret/s:0;
    var cashS=sum(sp.cash.map(function(r){return gn(r,'ItemsNetPrice');}));
    var wasS=sum(sp.was.map(function(r){return gn(r,'ItemsNetPrice');}));
    var insS=sum(sp.ins.map(function(r){return gn(r,'ItemsNetPrice');}));
    var avgS=totS/Math.max(brs.length,1);
    var sc=0;
    if(s>=avgS*0.8)sc+=30;else sc+=Math.round(s/Math.max(avgS,1)*30);
    if(rr<0.05)sc+=25;else if(rr<0.1)sc+=12;
    if(ai>=totAI)sc+=25;else sc+=Math.round(ai/Math.max(totAI,1)*25);
    if(ic>=totIC/Math.max(brs.length,1))sc+=20;else sc+=Math.round(ic/Math.max(totIC/Math.max(brs.length,1),1)*20);
    sc=Math.min(100,sc);
    return {b:b,s:s,cashS:cashS,wasS:wasS,insS:insS,ic:ic,ai:ai,rr:rr,ret:ret,sc:sc};
  }).sort(function(a,z){return z.s-a.s;});

  p.innerHTML=expBar('p-kpi','KPI')
  +'<div class="kpi-grid">'
    +kpiCard(t('totalSales'),fmt(totS),'💰','','#5eead4')
    +kpiCard(t('invCount'),fmtI(totIC),'🧾',t('avgInv')+': '+fmt(totAI),'#60a5fa')
    +kpiCard(t('totalRet'),fmt(sum(rets.map(function(r){return Math.abs(gn(r,'ItemsNetPrice'));}))),'🔄','','#f87171')
    +kpiCard(lang==='ar'?'عدد الفروع':' Branches',fmtI(brs.length),'🏪','','#a78bfa')
  +'</div>'
  +'<div class="card"><div class="card-title">📊 '+t('kpi')+' <span class="badge">'+brs.length+' '+t('branches')+'</span></div>'
  +'<div class="tbl-wrap"><table class="dtbl" id="kpiTbl"><thead><tr>'
    +'<th>#</th><th>'+t('branch')+'</th><th>'+t('totalSales')+'</th>'
    +'<th>💵 '+t('cash')+'</th><th>💊 '+t('wasfaty')+'</th><th>🏥 '+t('insurance')+'</th>'
    +'<th>'+t('invCount')+'</th><th>'+t('avgInv')+'</th><th>'+t('retRate')+'</th>'
    +'<th>Score</th><th>'+t('grade')+'</th>'
  +'</tr></thead><tbody>'
  +rows.map(function(r,i){
    var medal=i===0?'🥇 ':i===1?'🥈 ':i===2?'🥉 ':'';
    return '<tr>'
      +'<td>'+medal+(i+1)+'</td><td><strong>'+r.b+'</strong></td>'
      +'<td>'+fmt(r.s)+'</td>'
      +'<td style="color:#10b981">'+fmt(r.cashS)+'</td>'
      +'<td style="color:#3b82f6">'+fmt(r.wasS)+'</td>'
      +'<td style="color:#f59e0b">'+fmt(r.insS)+'</td>'
      +'<td>'+fmtI(r.ic)+'</td><td>'+fmt(r.ai)+'</td>'
      +'<td style="color:'+(r.rr>0.1?'#ef4444':r.rr>0.05?'#f59e0b':'#10b981')+'">'+fmtPct(r.rr)+'</td>'
      +'<td>'
        +'<div class="prog-bar" style="width:80px"><div class="prog-fill" style="width:'+r.sc+'%;background:'+grColor(r.sc)+'"></div></div>'
        +'<div style="font-size:10px;color:'+grColor(r.sc)+';margin-top:2px">'+r.sc+'%</div>'
      +'</td>'
      +'<td><span class="'+grClass(r.sc)+'">'+grLetter(r.sc)+'</span></td>'
    +'</tr>';
  }).join('')+'</tbody></table></div></div>';
}

