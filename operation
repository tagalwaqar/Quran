//  PARETO
// ═══════════════════════════════════════════════════════
function renderPareto(){
  var p=document.getElementById('p-pareto');
  if(!sales.length){p.innerHTML=noDataHtml();return;}
  var mode=p.getAttribute('data-mode')||'item';
  var map={};
  if(mode==='item'){
    sales.forEach(function(r){var k=(gv(r,'Name')||gv(r,'ItemBarCode')||'?').toString().trim().substring(0,40);map[k]=(map[k]||0)+gn(r,'ItemsNetPrice');});
  } else {
    sales.forEach(function(r){var k=String(gv(r,'BranchCode')||'?').trim();map[k]=(map[k]||0)+gn(r,'ItemsNetPrice');});
  }
  var items=Object.entries(map).sort(function(a,b){return b[1]-a[1];}).slice(0,30);
  var total=sum(items.map(function(x){return x[1];}));var cum=0;
  var labels=items.map(function(x){return x[0];});
  var vals=items.map(function(x){return x[1];});
  var cumPct=vals.map(function(v){cum+=v;return (cum/total*100).toFixed(1);});
  var cut80=vals.findIndex(function(_,i){return parseFloat(cumPct[i])>=80;});

  p.innerHTML=expBar('p-pareto','Pareto')
  +'<div class="cat-tabs">'
    +'<button class="cat-tab'+(mode==='item'?' active':'')+'" onclick="setPM(\'item\')">📦 '+(lang==='ar'?'حسب الصنف':'By Item')+'</button>'
    +'<button class="cat-tab'+(mode==='branch'?' active':'')+'" onclick="setPM(\'branch\')">🏪 '+(lang==='ar'?'حسب الفرع':'By Branch')+'</button>'
  +'</div>'
  +'<div class="card"><div class="card-title">📉 '+t('pareto')+' — '+(mode==='item'?'الأصناف':'الفروع')
    +(cut80>=0?' <span class="badge">أعلى '+(cut80+1)+' '+(mode==='item'?'صنف':'فرع')+' = 80%</span>':'')+'</div>'
  +'<div class="ch-wrap" style="height:320px"><canvas id="parChart"></canvas></div></div>'
  +'<div class="card"><div class="card-title">📋 تفاصيل 80/20</div>'
