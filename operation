function applyFilters(){
  var branch=document.getElementById('fBranch').value;
  var month=document.getElementById('fMonth').value;
  var cat=document.getElementById('fCat').value;
  var d=raw;
  if(activeQuarter>0){
    var qm={1:[1,2,3],2:[4,5,6],3:[7,8,9],4:[10,11,12]};
    var qms=qm[activeQuarter];
    d=d.filter(function(r){var dt=new Date(gv(r,'InvoiceDate'));return dt&&qms.indexOf(dt.getMonth()+1)>=0;});
  }
  if(branch)d=d.filter(function(r){return String(gv(r,'BranchCode')||'').trim()===branch;});
  if(month)d=d.filter(function(r){return String(gv(r,'MONTHS')||'').trim()===month;});
  if(cat&&cat!=='all')d=d.filter(function(r){return String(gv(r,'InvoiceType')||'')===cat;});
  rets=d.filter(function(r){return String(gv(r,'InvoiceType')||'').toLowerCase()==='return';});
  sales=d.filter(function(r){return String(gv(r,'InvoiceType')||'').toLowerCase()!=='return';});
  updateBellCount();
}
function applyAndRender(){applyFilters();renderPanel();}
function setQuarter(q){
  activeQuarter=q;
  ['qAll','q1','q2','q3','q4'].forEach(function(id,i){
    var el=document.getElementById(id);if(el)el.classList.toggle('active',(q===0?i===0:i===q));
  });
  applyAndRender();
}

function updateBellCount(){
  var alerts=0;
  if(rets.length>0){var rr=sum(sales.map(function(r){return gn(r,'ItemsNetPrice');}));var rv=sum(rets.map(function(r){return Math.abs(gn(r,'ItemsNetPrice'));}));if(rr>0&&rv/rr>0.05)alerts++;}
  document.getElementById('bellCount').textContent=alerts;
}
function showAlerts(){
  var msgs=[];
  if(rets.length>0){var ts=sum(sales.map(function(r){return gn(r,'ItemsNetPrice');}));var tr=sum(rets.map(function(r){return Math.abs(gn(r,'ItemsNetPrice'));}));if(ts>0&&tr/ts>0.05)msgs.push('⚠️ نسبة المرتجعات مرتفعة: '+fmtPct(tr/ts));}
  if(sales.length===0)msgs.push('📂 لا توجد بيانات مبيعات محملة');
  alert(msgs.length?msgs.join('\n'):(lang==='ar'?'✅ لا توجد تنبيهات':'✅ No alerts'));
}

