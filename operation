    +'<div class="card" style="margin:0"><div class="card-title">🏷️ '+(lang==='ar'?'المبيعات حسب الفئة':'Sales by Category')+'</div>'
    +'<div class="ch-wrap" style="height:300px"><canvas id="catCatChart"></canvas></div></div>'
  +'</div>'
  // Division table
  +'<div class="card"><div class="card-title">📊 '+(lang==='ar'?'تفاصيل الأقسام':'Division Details')+'</div>'
  +'<div class="tbl-wrap"><table class="dtbl" id="catDivTbl"><thead><tr>'
    +'<th>#</th><th>'+(lang==='ar'?'القسم':'Division')+'</th>'
    +'<th>'+(lang==='ar'?'المبيعات':'Sales')+'</th>'
    +'<th>%</th><th>'+(lang==='ar'?'عدد الأصناف':'Items')+'</th>'
    +'<th>'+(lang==='ar'?'متوسط الصنف':'Avg/Item')+'</th>'
  +'</tr></thead><tbody>'
  +divEntries.map(function(x,i){
    var pct=totS>0?(x[1]/totS*100).toFixed(1):'0.0';
    var ai=divCnt[x[0]]>0?(x[1]/divCnt[x[0]]):0;
    return '<tr>'
      +'<td>'+(i+1)+'</td>'
      +'<td><strong>'+divLbl(x[0])+'</strong></td>'
      +'<td>'+fmt(x[1])+'</td>'
      +'<td>'+pct+'%</td>'
      +'<td>'+fmtI(divCnt[x[0]])+'</td>'
      +'<td>'+fmt(ai)+'</td>'
    +'</tr>';
  }).join('')+'</tbody></table></div></div>'
  // Category table
  +'<div class="card"><div class="card-title">📋 '+(lang==='ar'?'تفاصيل الفئات':'Category Details')+'</div>'
  +'<div class="tbl-wrap"><table class="dtbl" id="catCatTbl"><thead><tr>'
    +'<th>#</th><th>'+(lang==='ar'?'الفئة':'Category')+'</th>'
    +'<th>'+(lang==='ar'?'المبيعات':'Sales')+'</th>'
    +'<th>%</th><th>'+(lang==='ar'?'عدد الأصناف':'Items')+'</th>'
    +'<th>'+(lang==='ar'?'القسم الرئيسي':'Parent Division')+'</th>'
  +'</tr></thead><tbody>'
  +(function(){
    // For each category, find the dominant division
    var catDiv={};
    sales.forEach(function(r){
      var mat=gv(r,'MaterialNumber');
      var d=getItemDiv(mat), c=getItemCat(mat);
      var v=gn(r,'ItemsNetPrice');
      if(!catDiv[c]) catDiv[c]={};
      catDiv[c][d]=(catDiv[c][d]||0)+v;
    });
    return catEntries.map(function(x,i){
      var pct=totS>0?(x[1]/totS*100).toFixed(1):'0.0';
      var domDiv=Object.entries(catDiv[x[0]]||{}).sort(function(a,b){return b[1]-a[1];})[0];
      var domLbl=domDiv?divLbl(domDiv[0]):'-';
      return '<tr>'
        +'<td>'+(i+1)+'</td>'
        +'<td><strong>'+catLbl(x[0])+'</strong></td>'
        +'<td>'+fmt(x[1])+'</td>'
        +'<td>'+pct+'%</td>'
        +'<td>'+fmtI(catCnt[x[0]])+'</td>'
        +'<td style="font-size:11px">'+domLbl+'</td>'
      +'</tr>';
    }).join('');
  })()+'</tbody></table></div></div>';

  setTimeout(function(){
    // Division doughnut
    makeChart('catDivChart',{
      type:'doughnut',
      data:{
        labels:divEntries.map(function(x){return divLbl(x[0]);}),
        datasets:[{
          data:divEntries.map(function(x){return x[1];}),
          backgroundColor:divEntries.map(function(_,i){return divColors[i%divColors.length];}),
          borderWidth:2,borderColor:'#1e293b'
        }]
