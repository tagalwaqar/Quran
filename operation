    +'<div style="font-size:20px;font-weight:900;color:var(--pd);margin:6px 0">'+fmt(v)+'</div>'
    +'<span class="season-badge s-high">🔮 توقع</span>'
  +'</div>';}).join('')+'</div>'
  +'<div class="card"><div class="card-title">📈 '+t('forecast')+'</div>'
  +'<div class="ch-wrap" style="height:300px"><canvas id="fcChart"></canvas></div></div>';

