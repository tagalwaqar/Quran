      options:{responsive:true,maintainAspectRatio:false,indexAxis:'y',
        plugins:{legend:{display:false}},
        scales:{x:{ticks:{color:'#94a3b8'}},y:{ticks:{color:'#94a3b8',font:{family:'Cairo',size:10}}}}
      }
    });
  },50);
}

// ═══════════════════════════════════════════════════════
//  AUDIT
// ═══════════════════════════════════════════════════════
function renderAudit(){
  var p=document.getElementById('p-audit');
  if(!sales.length){p.innerHTML=noDataHtml();return;}
  var brs=branches(sales);
  var totS=sum(sales.map(function(r){return gn(r,'ItemsNetPrice');}));
  var totIC=invSet(sales);var totAI=totIC?totS/totIC:0;
  var results=brs.map(function(b){
    var bd=sales.filter(function(r){return String(gv(r,'BranchCode')||'').trim()===b;});
    var br=rets.filter(function(r){return String(gv(r,'BranchCode')||'').trim()===b;});
    var s=sum(bd.map(function(r){return gn(r,'ItemsNetPrice');}));
    var ret=sum(br.map(function(r){return Math.abs(gn(r,'ItemsNetPrice'));}));
    var ic=invSet(bd);var ai=ic?s/ic:0;var rr=s>0?ret/s:0;
    var items={};bd.forEach(function(r){var k=gv(r,'MaterialNumber');if(k)items[k]=1;});
    var avgBS=totS/Math.max(brs.length,1);var avgIC=totIC/Math.max(brs.length,1);
    var checks=[s>=avgBS*0.8,rr<0.05,ai>=totAI*0.8,ic>=avgIC,Object.keys(items).length>=5,ret<s*0.15];
    var sc=Math.round(checks.filter(Boolean).length/checks.length*100);
    return {b:b,sc:sc,checks:checks,s:s,rr:rr,ai:ai};
  }).sort(function(a,z){return z.sc-a.sc;});

  var checkLabels=[
    'مبيعات ≥ 80% المتوسط','نسبة مرتجع < 5%',
    'متوسط فاتورة ≥ 80%','عدد فواتير ≥ المتوسط',
    'تنوع أصناف ≥ 5','مرتجعات < 15% المبيعات'
  ];

  p.innerHTML=expBar('p-audit','Audit')
  +'<div class="card"><div class="card-title">✅ '+t('audit')+'</div>'
  +'<div class="tbl-wrap"><table class="dtbl" id="audTbl"><thead><tr>'
  +'<th>#</th><th>'+t('branch')+'</th><th>'+t('score')+'</th>'
  +checkLabels.map(function(l){return '<th style="font-size:9px;max-width:70px;white-space:normal;line-height:1.3">'+l+'</th>';}).join('')
  +'</tr></thead><tbody>'
  +results.map(function(r,i){
    return '<tr><td>'+(i+1)+'</td><td><strong>'+r.b+'</strong></td>'
      +'<td><span class="'+grClass(r.sc)+'">'+grLetter(r.sc)+' '+r.sc+'%</span></td>'
      +r.checks.map(function(c){return '<td class="'+(c?'chk-ok':'chk-no')+'">'+(c?'✓':'✗')+'</td>';}).join('')+'</tr>';
  }).join('')+'</tbody></table></div></div>';
}

// ═══════════════════════════════════════════════════════
//  ANNUAL
// ═══════════════════════════════════════════════════════
function renderAnnual(){
  var p=document.getElementById('p-annual');
  var allM=months(raw);if(!allM.length){p.innerHTML=noDataHtml();return;}
  var mData=allM.map(function(m){
    var ms=sales.filter(function(r){return String(gv(r,'MONTHS')||'').trim()===m;});
    var mr=rets.filter(function(r){return String(gv(r,'MONTHS')||'').trim()===m;});
    var s=sum(ms.map(function(r){return gn(r,'ItemsNetPrice');}));
    var ret=sum(mr.map(function(r){return Math.abs(gn(r,'ItemsNetPrice'));}));
    return {m:m,s:s,ret:ret,net:s-ret};
  });
  var totS=sum(mData.map(function(d){return d.s;}));
  var bestM=mData.reduce(function(a,b){return b.s>a.s?b:a;});
  var worstM=mData.reduce(function(a,b){return b.s<a.s?b:a;});
  var growth=mData.length>=2?(mData[mData.length-1].s-mData[0].s)/Math.max(mData[0].s,1)*100:0;

  p.innerHTML=expBar('p-annual','Annual')
  +'<div class="kpi-grid">'
    +kpiCard('إجمالي الفترة',fmt(totS),'📅',allM.length+' شهراً','#5eead4')
    +kpiCard('أفضل شهر',bestM.m,'🔥',fmt(bestM.s),'#10b981')
    +kpiCard('أضعف شهر',worstM.m,'❄️',fmt(worstM.s),'#3b82f6')
    +kpiCard('نمو الفترة',(growth>=0?'+':'')+growth.toFixed(1)+'%','📈','من أول لآخر شهر',growth>=0?'#10b981':'#ef4444')
  +'</div>'
  +'<div class="card"><div class="card-title">📊 المبيعات — المرتجعات — الصافي</div>'
  +'<div class="ch-wrap" style="height:320px"><canvas id="annChart"></canvas></div></div>';

  setTimeout(function(){
    makeChart('annChart',{type:'bar',
      data:{labels:mData.map(function(d){return d.m;}),datasets:[
        {label:t('totalSales'),data:mData.map(function(d){return d.s;}),backgroundColor:mData.map(function(d){return d.m===bestM.m?'rgba(16,185,129,.85)':d.m===worstM.m?'rgba(239,68,68,.5)':'rgba(13,148,136,.6)';}),borderRadius:6},
        {type:'line',label:'الصافي',data:mData.map(function(d){return d.net;}),borderColor:'#f59e0b',borderDash:[4,4],tension:.4,pointRadius:3,yAxisID:'y'}
      ]},
      options:{responsive:true,maintainAspectRatio:false,
        plugins:{legend:{labels:{color:'#94a3b8',font:{family:'Cairo'}}}},
        scales:{x:{ticks:{color:'#94a3b8'}},y:{ticks:{color:'#94a3b8'}}}}});
  },50);
}

