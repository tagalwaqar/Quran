function handleDrop(ev){
  ev.preventDefault();
  document.getElementById('upZone').classList.remove('drag');
  handleFiles(ev.dataTransfer.files);
}
function handleFiles(files){
  if(!files||!files.length)return;
  loader(true,'جاري قراءة الملفات...');
  var all=[];var pending=files.length;
  Array.from(files).forEach(function(f){
    var rd=new FileReader();
    rd.onload=function(e){
      var wb=XLSX.read(e.target.result,{type:'array',cellDates:true});
      wb.SheetNames.forEach(function(sn){
        var ws=wb.Sheets[sn];
        var rows=XLSX.utils.sheet_to_json(ws,{defval:''});
        rows.forEach(function(r){
          // Add MONTHS column if InvoiceDate present
          if(r.InvoiceDate){
            var dt=new Date(r.InvoiceDate);
            if(!isNaN(dt)){
              r.MONTHS=dt.toLocaleDateString(lang==='ar'?'ar-SA':'en-US',{year:'numeric',month:'short'});
              r._hour=dt.getHours();
            }
          }
          // Parse InvoiceTime as hour
          if(r.InvoiceTime&&!r._hour){
            var parts=String(r.InvoiceTime).split(':');
            if(parts.length>=2)r._hour=parseInt(parts[0])||0;
          }
        });
        all=all.concat(rows);
      });
      pending--;
      if(pending===0){finishImport(all,files);}
    };
    rd.readAsArrayBuffer(f);
  });
}
function finishImport(data,files){
  raw=data;
  buildFilters();applyFilters();
  document.getElementById('dstatus').style.display='flex';
  document.getElementById('dstatTxt').textContent=t('dataLoaded')+': '+fmtI(raw.length)+' '+t('records');
  document.getElementById('fileInfo').textContent=fmtI(raw.length)+' '+t('records')+' ('+files.length+' ملف)';
  document.getElementById('clearBtn').style.display='inline-flex';
  document.getElementById('upStatus').textContent='✅ تم تحميل '+raw.length+' سجل من '+files.length+' ملف';
  loader(false);
  closeOverlay('uploadModal');
  renderPanel();
  showToast('✅ تم تحميل البيانات بنجاح — '+fmtI(raw.length)+' سجل');
}
function clearData(){
  if(!confirm(lang==='ar'?'مسح كل البيانات؟':'Clear all data?'))return;
  raw=[];sales=[];rets=[];
  document.getElementById('dstatus').style.display='none';
  document.getElementById('fileInfo').textContent=lang==='ar'?'لم يتم رفع ملفات':'No files uploaded';
  document.getElementById('clearBtn').style.display='none';
  renderPanel();showToast('🗑️ '+(lang==='ar'?'تم مسح البيانات':'Data cleared'));
}

