        plugins:{legend:{position:'right',labels:{color:'#94a3b8',font:{family:'Cairo',size:11},padding:8}},
          tooltip:{callbacks:{label:function(c){return ' '+c.label+': '+c.raw.toLocaleString('ar-SA',{minimumFractionDigits:2})+' ر.س ('+(c.raw/totS*100).toFixed(1)+'%)';}}}}
      }
    });
    // Category horizontal bar
    var top10=catEntries.slice(0,10);
    makeChart('catCatChart',{
      type:'bar',
      data:{
        labels:top10.map(function(x){return catLbl(x[0]);}),
        datasets:[{
